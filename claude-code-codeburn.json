          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 10
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Daily Activity",
      "description": "Daily cost and call-count proxy from Prometheus. Calls use changes(claude_code_cost_usage_USD_total[1d]) to avoid a mixed datasource panel. Calls is a LOWER BOUND, not a count: changes() counts scrape-to-scrape value changes, so all calls inside one 15s scrape count as one, and a call that adds no cost counts as none. Read the \"API Calls\" stat above for the true count from Loki.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(claude_code_cost_usage_USD_total{job=\"otel-collector\"}[1d]))",
          "legendFormat": "Cost",
          "interval": "1d"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(changes(claude_code_cost_usage_USD_total{job=\"otel-collector\"}[1d]))",
          "legendFormat": "Calls",
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "By Model",
      "description": "Model-level cost, cache percentage, and call-count proxy from OTEL Prometheus metrics. Calls is a LOWER BOUND, not a count: changes() counts scrape-to-scrape value changes, so all calls inside one 15s scrape count as one, and a call that adds no cost counts as none.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total{job=\"otel-collector\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "Cost USD"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (model) (increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=\"cacheRead\"}[$__range])) / sum by (model) (increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=~\"input|cacheRead|cacheCreation\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "Cache %"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model) (changes(claude_code_cost_usage_USD_total{job=\"otel-collector\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "Calls"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "model",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Cost USD",
              "Value #B": "Cache %",
              "Value #C": "Calls"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost USD"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.displayMode",
                "value": "gradient"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cache %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Cost USD"
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Core Tools",
      "description": "Built-in tool calls by tool_name from Loki tool_result events. Skill, Agent, Task and mcp_tool are excluded here, because the two panels beside this one count them; without the exclusion the three panels count the same calls twice.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | tool_name!~\"Skill|Agent|Task|mcp_tool\" [$__range]))",
          "legendFormat": "{{tool_name}}",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "sum"
          ],
          "fields": ""
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 31
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Skills and Agents",
      "description": "Skill, Agent, and Task tool_result calls. Cost attribution is excluded because OTEL does not expose per-skill cost.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
