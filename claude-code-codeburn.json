        "x": 8,
        "y": 5
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cache Read Tokens",
      "description": "Tokens served from cache over the visible range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=\"cacheRead\"}[$__range]))",
          "legendFormat": "Cache read"
        }
