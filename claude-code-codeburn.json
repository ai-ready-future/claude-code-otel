            "sum"
          ],
          "fields": ""
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 31
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "MCP Servers",
      "description": "Total MCP tool calls. On this stack MCP calls collapse to the literal tool_name \"mcp_tool\" (verified via the Loki label gate); no per-server breakdown is available.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | tool_name=\"mcp_tool\" [$__range]))",
          "legendFormat": "{{tool_name}}",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
