        "x": 0,
        "y": 5
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Output Tokens",
      "description": "Output tokens over the visible range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=\"output\"}[$__range]))",
