      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=\"cacheCreation\"}[$__range]))",
          "legendFormat": "Cache written"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
