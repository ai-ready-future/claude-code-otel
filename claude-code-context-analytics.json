          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | unwrap duration_ms [$__range])) / sum(count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" [$__range]))",
          "legendFormat": "avg_latency_ms",
          "queryType": "instant",
