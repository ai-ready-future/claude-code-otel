    {
      "id": 5,
      "type": "table",
      "title": "Context Band x Cost/Latency (per request, main thread)",
      "description": "Each api_request bucketed by its OWN context size (input + cache_read + cache_creation tokens), main thread only. Per-band ratios are computed server-side in LogQL; the table only joins the columns on the band index. Band N = context in [N*100k, (N+1)*100k).\n\nAll five queries share the same prefix: the stream selector, the query_source filter, and the two label_format steps that make `ctx` and `band`. LogQL permits only one `unwrap` per query, which is why they are five targets and not one. Keep the prefixes the same in all five if you change the band width or the filters.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "Requests",
          "expr": "sum by (band) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` [$__range]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "Cost/req",
          "expr": "sum by (band) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` | unwrap cost_usd [$__range])) / sum by (band) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` [$__range]))"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "Avg latency (ms)",
          "expr": "sum by (band) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` | unwrap duration_ms [$__range])) / sum by (band) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` [$__range]))"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "Output tok/req",
          "expr": "sum by (band) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` | unwrap output_tokens [$__range])) / sum by (band) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` [$__range]))"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "Cache-read %",
          "expr": "sum by (band) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` | unwrap cache_read_tokens [$__range])) / sum by (band) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | query_source=\"repl_main_thread\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | label_format band=`{{ div (int .ctx) 100000 }}` | unwrap ctx [$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": [
              "band"
            ]
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "band",
            "mode": "outerTabular"
          }
        },
        {
          "id": "organize",
