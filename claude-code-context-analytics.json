    {
      "id": 10,
      "type": "table",
      "title": "Median Context Size by Query Source",
      "description": "Median computed context (input + cache_read + cache_creation) per request, grouped by the subsystem that issued it. repl_main_thread is your interactive conversation; agent:* are sub-agents; compact/away_summary/etc. are auxiliary. Rendered as a value-sorted table with inline bar-gauge cells: the bar chart re-sorts the category axis alphabetically regardless of frame order (merge/sortBy/reduce all discarded), so the only reliable largest-to-smallest sort is the table's panel-level sortBy.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "legendFormat": "",
          "expr": "sort_desc(quantile_over_time(0.5, {service_name=\"claude-code\"} | event_name=\"api_request\" | label_format ctx=`{{ add (int .input_tokens) (int .cache_read_tokens) (int .cache_creation_tokens) }}` | unwrap ctx [$__range]) by (query_source))"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": [
              "query_source"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "query_source": 0,
              "Value": 1
            },
