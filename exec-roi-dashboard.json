{
  "title": "Executive / ROI",
  "uid": "claude-code-exec-roi",
  "schemaVersion": 27,
  "version": 1,
  "tags": [
    "claude-code",
    "productivity",
    "executive",
    "roi"
  ],
  "templating": {
    "list": [
      {
        "name": "user",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(claude_code_cost_usage_USD_total, user_email)"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "price_input_sonnet45",
        "type": "constant",
        "query": "3.00",
        "current": {
          "text": "3.00",
          "value": "3.00"
        }
      },
      {
        "name": "price_output_sonnet45",
        "type": "constant",
        "query": "15.00",
        "current": {
          "text": "15.00",
          "value": "15.00"
        }
      },
      {
        "name": "price_cacheread_sonnet45",
        "type": "constant",
        "query": "0.30",
        "current": {
          "text": "0.30",
          "value": "0.30"
        }
      },
      {
        "name": "price_cachewrite_sonnet45",
        "type": "constant",
        "query": "3.75",
        "current": {
          "text": "3.75",
          "value": "3.75"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Leverage multiplier (Nx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(floor(sum(increase(claude_code_active_time_seconds_total{type=\"cli\",user_email=~\"$user\"}[$__interval])) / sum(increase(claude_code_active_time_seconds_total{type=\"user\",user_email=~\"$user\"}[$__interval]))), 1)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Quality-adjusted activity",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"output\",user_email=~\"$user\"}[$__interval]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({event=\"tool_decision\"} | decision=\"accept\" [$__interval])) / sum(count_over_time({event=\"tool_decision\"} [$__interval]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "operator": "*",
            "left": "A",
            "right": "B",
            "replaceFields": true
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Total cost (daily)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cc:cost_usd:daily{user_email=~\"$user\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cost per active hour",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cc:cost_per_active_hour:daily{user_email=~\"$user\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost of rejected work ($)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_cost_usage_USD_total{user_email=~\"$user\"}[$__interval]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({event=\"tool_decision\"} | decision=\"reject\" [$__interval])) / sum(count_over_time({event=\"tool_decision\"} [$__interval]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "operator": "*",
            "left": "A",
            "right": "B",
            "replaceFields": true
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Accepted edits over time",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({event=\"tool_decision\"} | decision=\"accept\" [$__interval]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Output per prompt",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"output\",user_email=~\"$user\"}[$__interval]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({event=\"user_prompt\"} [$__interval]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "operator": "/",
            "left": "A",
            "right": "B",
            "replaceFields": true
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Spend by model and query_source",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, query_source) (increase(claude_code_cost_usage_USD_total{user_email=~\"$user\"}[$__interval]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache $ saved",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\",user_email=~\"$user\"}[$__range])) / 1e6) * ($price_input_sonnet45 - $price_cacheread_sonnet45)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Active time by type + adoption",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (increase(claude_code_active_time_seconds_total{user_email=~\"$user\"}[$__interval]))"
        },
        {
          "refId": "B",
          "expr": "sum by (start_type) (cc:sessions:daily{user_email=~\"$user\"})"
        }
      ]
    }
  ]
}
